{
  "name": "character-gallery",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first character card gallery. A browser-only Svelte 5 + Vite app with a masonry gallery, search, sort, lightbox, batch delete, and image export. Data stays in the browser.",
  "license": "Apache-2.0",
  "author": "SairaDev02",
  "homepage": "https://github.com/SairaDev02/sillytavern-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SairaDev02/sillytavern-vault.git"
  },
  "bugs": {
    "url": "https://github.com/SairaDev02/sillytavern-vault/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "vite",
    "tailwindcss",
    "typescript",
    "indexeddb",
    "gallery",
    "masonry",
    "character-cards",
    "sillytavern",
    "local-first",
    "offline",
    "spa"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:dev": "node scripts/start.mjs --dev",
    "check": "svelte-check",
    "check:watch": "svelte-check --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/ui": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
